---
import type { Lang } from '@/i18n/ui';
import { routes, useTranslations } from '@/i18n/utils';
import { pad, type Project } from '@/lib/projects';

interface Props {
  lang: Lang;
  project: Project;
  active?: boolean;
}

const { lang, project, active = false } = Astro.props;
const t = useTranslations(lang);
const d = project.data;
const num = pad(d.order);
const href = routes.project(lang, d.urlSlug);
const rows = [
  { label: t('projects.stack'), items: d.stack },
  { label: t('projects.infra'), items: d.infra },
  { label: t('projects.focus'), items: d.focus },
].filter((r) => r.items.length);
---

<article
  class="card"
  id={`projeto-${num}`}
  data-project={num}
  data-title={d.title}
  data-active={active ? 'true' : undefined}
  aria-labelledby={`projeto-${num}-title`}
  data-reveal
>
  <div class="card__cover">
    <img src={d.cover} alt={d.coverAlt} width="1200" height="750" loading="lazy" decoding="async" />
  </div>

  <div class="card__body">
    <header class="card__head">
      <span class="card__num display" aria-hidden="true">{num}</span>
      <span class="label card__kind">{d.kind}</span>
    </header>

    <h3 class="card__title display" id={`projeto-${num}-title`}>{d.title}</h3>
    <p class="card__summary">{d.summary}</p>

    <dl class="card__meta">
      {
        rows.map((r) => (
          <div>
            <dt>{r.label}</dt>
            <dd class="mono">{r.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>

    <p class="card__status mono">{d.status}</p>

    <a class="card__link" href={href}>
      {t('projects.open')} <span class="arrow" aria-hidden="true">→</span>
      <span class="visually-hidden">— {d.title}</span>
    </a>
  </div>
</article>

<style>
  .card {
    --c-bg: var(--ink-2);
    --c-fg: var(--paper);
    --c-muted: var(--muted-on-ink);
    --c-line: var(--line-on-ink);

    position: relative;
    display: flex;
    flex-direction: column;
    /* Compensa cabeçalho + índice fixos ao pular para o projeto */
    scroll-margin-top: calc(var(--header-h) + 5.5rem);
    border: 1px solid var(--line-on-ink);
    border-radius: var(--radius);
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: hidden;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  /* Inversão de polaridade: o projeto em foco (ou sob o cursor) vira papel */
  .card[data-active],
  .card:hover,
  .card:focus-within {
    --c-bg: var(--paper);
    --c-fg: var(--ink);
    --c-muted: var(--muted-on-paper);
    --c-line: var(--line-on-paper);
    border-color: var(--paper);
  }

  .card__cover {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--c-line);
    background: var(--paper-2);
    overflow: hidden;
  }

  .card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .card:hover .card__cover img {
    transform: scale(1.03);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .card__num {
    font-size: var(--step-2);
    line-height: 1;
  }

  .card .card__kind {
    color: var(--c-muted);
    text-align: right;
  }

  .card__title {
    font-size: var(--step-1);
    line-height: 1;
  }

  .card__summary {
    color: var(--c-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .card__meta {
    display: grid;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-line);
  }

  .card__meta div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .card__meta dt {
    color: var(--c-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card__status {
    color: var(--c-muted);
    font-size: 0.75rem;
  }

  .card__status::before {
    content: '● ';
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: auto;
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* O cartão inteiro é clicável, mas só existe UM link (bom para leitores de tela) */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: 3px solid var(--paper);
    outline-offset: 4px;
  }
</style>
